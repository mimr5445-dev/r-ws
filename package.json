{
  "name": "rw-style-visual-scenario-studio",
  "private": true,
  "version": "0.3.0",
  "description": "Deterministic 30 TPS tactical/geopolitical scenario studio with A* navigation, live YAML authoring and WebM export.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.5",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/core/core.test.ts src/packs/packSchema.test.ts",
    "catalog": "tsx scripts/generate-catalog.ts",
    "verify": "tsc --noEmit && tsx --test src/core/core.test.ts src/packs/packSchema.test.ts && vite build"
  },
  "dependencies": {
    "d3-geo": "^3.1.2",
    "i18n-iso-countries": "^7.14.0",
    "js-yaml": "^5.5.0",
    "lucide-react": "^0.546.0",
    "pixi.js": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
