# بوابة الذكاء الاصطناعي المفتوح (بدون أي مفتاح API)
# -----------------------------------------------------
# لا تحتاج مفتاحًا إطلاقًا: البوابة /api/ai تتصل بمحرّك نماذج مفتوح المصدر
# يعمل على جهازك أو على خادمك، عبر واجهة متوافقة مع OpenAI.
#
# اتركه فارغًا ليتم فحص المنافذ الشائعة تلقائيًا:
#   Ollama       http://127.0.0.1:11434/v1
#   llama.cpp    http://127.0.0.1:8080/v1
#   vLLM         http://127.0.0.1:8000/v1
#   LM Studio    http://127.0.0.1:1234/v1
AI_BASE_URL=""

# اسم النموذج المفتوح (فارغ = أول نموذج متاح على المحرّك)
# أمثلة: qwen2.5:7b-instruct | llama3.1:8b-instruct | mistral:7b-instruct | gemma2:9b-instruct
AI_MODEL=""

# اختياري فقط: إن كان محرّكك المحلي محميًا بمفتاح خاص بك (ليس مفتاحًا سحابيًا مدفوعًا)
AI_API_KEY=""

# ── للاستخدام من الهاتف (الأنسب) ─────────────────────────────
# محرّك واحد مشترك يعيش على الخادم/الإنترنت. الهاتف لا يحتاج أي عنوان ولا مفتاح،
# والمفتاح هنا يبقى على الخادم ولا يُرسل للمتصفح أبدًا.
# مثال Hugging Face Space بقالب vLLM:  https://xxxx.hf.space/v1
AI_SHARED_BASE_URL=""
AI_SHARED_MODEL="Qwen/Qwen2.5-7B-Instruct"
AI_SHARED_API_KEY=""

# منفذ الاستوديو (الواجهة + البوابة على نفس المنفذ)
PORT="3000"
HOST="0.0.0.0"
